import java.util.*;

class Solution {
    public List<List<Integer>> subsets(int[] nums) {

        List<List<Integer>> ans = new ArrayList<>();

        int n = nums.length;

        for (int i = 0; i < (1 << n); i++) {

            List<Integer> list = new ArrayList<>();

            for (int j = 0; j < n; j++) {

                if ((i & (1 << j)) != 0) {
                    list.add(nums[j]);
                }
            }

            ans.add(list);
}
return ans
}
}
# 2. Single Number II (Two Unique Numbers)

### Steps

1. XOR all elements.
2. Find the rightmost set bit.
3. Divide elements into two groups based on that bit.
4. XOR elements of each group.

```java
class Solution {
    public int[] singleNum(int[] arr) {

        int xorAll = 0;

        for(int ele : arr) {
            xorAll ^= ele;
        }

        int setBit = xorAll & -xorAll;

        int num1 = 0;
        int num2 = 0;

        for(int num : arr) {

            if((num & setBit) != 0) {
                num1 ^= num;
            }
            else {
                num2 ^= num;
            }
        }

        if(num1 < num2) {
            return new int[]{num1, num2};
        }

        return new int[]{num2, num1};
    }
}
```


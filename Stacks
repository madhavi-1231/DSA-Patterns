public class SumofSubArrayMinimum123 {
 public static void main(String[] args){
    int arr[]={3,1,2,4};
    int sum=0;
    for(int i=0;i<arr.length;i++){
        int mini=Integer.MAX_VALUE;
        for(int j=i;j<arr.length;j++){
             mini=Math.min(mini,arr[j]);
             sum+=mini;
        }
    }
    System.out.println(sum);
 }   

import java.util.*;

public class InfixToPostFix {

    static int priority(char ch) {
        if (ch == '+' || ch == '-') {
            return 1;
        }
        else if (ch == '*' || ch == '/') {
            return 2;
        }
        else {
            return 3;
        }
    }

    static Stack<Character> st = new Stack<>();

    public static void main(String[] args) {
        String exp = "(a+b)*c";
        infToPost(exp);
    }

    static void infToPost(String exp) {

        String ans = "";

        for (char c : exp.toCharArray()) {

            if (Character.isLetterOrDigit(c)) {
                ans += c;
            }

            else if (c == '(') {
                st.push(c);
            }

            else if (c == ')') {

                while (!st.isEmpty() && st.peek() != '(') {
                    ans += st.pop();
                }

                if (!st.isEmpty()) {
                    st.pop();
                }
            }

            else {

                while (!st.isEmpty() &&
                       st.peek() != '(' &&
                       priority(st.peek()) >= priority(c)) {

                    ans += st.pop();
                }

                st.push(c);
            }
        }

        while (!st.isEmpty()) {
            ans += st.pop();
        }

        System.out.println(ans);
    }
}

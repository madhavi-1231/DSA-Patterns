public class DistinctSubsequences {
    public static void main(String[] args){
        String s="axbxax";
        String t="axa";
        int i=s.length()-1;
        int j=t.length()-1;
        countDistinct(i,j,s,t);
    }
    static int countDistinct(int i,int j,String s,String t){
         if(j<0){
            return 1;
         }
        if(i<0){
            return 0;
        }
             if(s.charAt(i)==t.charAt(j)){
                return countDistinct(i-1,j-1,s,t) +countDistinct(i-1,j,s,t);
             }
             else{
                return countDistinct(i-1,j,s,t);
             }
    }
}




















public class MiniCoins {
    public static void main(String[] args){
        int coins[]={2,5};
        int amount=3;
        int n=coins.length;
        System.out.println(miniCount(coins,n-1,amount));
    }
    static int miniCount(int coins[],int index,int target){
          if(index==0){
              if(target%coins[0]==0){
                return target/coins[0];
              }
              return Integer.MAX_VALUE;
          }
        int notTake=miniCount(coins,index-1,target);
        int take=Integer.MAX_VALUE;
        if(coins[index]<=target){
            take=1+miniCount(coins,index,target-coins[index]);
        }
        return Math.min(take,notTake);
    }
}



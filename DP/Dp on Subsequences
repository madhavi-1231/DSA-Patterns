class Solution {

    int totalSum;
    Integer[][] dp;

    public int minimumDifference(int[] nums) {

        totalSum = 0;

        for (int num : nums)
            totalSum += num;

        dp = new Integer[nums.length][totalSum + 1];

        return solve(0, 0, nums);
    }

    private int solve(int index, int sum1, int[] nums) {

        if (index == nums.length) {

            int sum2 = totalSum - sum1;
            return Math.abs(sum1 - sum2);
        }

        if (dp[index][sum1] != null)
            return dp[index][sum1];

        // Put current element in subset1
        int take = solve(index + 1, sum1 + nums[index], nums);

        // Put current element in subset2
        int notTake = solve(index + 1, sum1, nums);

        return dp[index][sum1] = Math.min(take, notTake);
    }
}





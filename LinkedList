7. Add Two Numbers
Pattern
Node add(Node l1, Node l2){


    Node dummy = new Node(-1);
    Node temp = dummy;


    int carry = 0;


    while(l1 != null || l2 != null || carry != 0){


        int sum = carry;


        if(l1 != null){
            sum += l1.data;
            l1 = l1.next;
        }


        if(l2 != null){
            sum += l2.data;
            l2 = l2.next;
        }


        temp.next = new Node(sum % 10);
        carry = sum / 10;


        temp = temp.next;
    }


    return dummy.next;
}

6. Palindrome Linked List
Pattern
boolean isPalindrome(Node head){


    Node slow = head;
    Node fast = head;


    while(fast != null && fast.next != null){
        slow = slow.next;
        fast = fast.next.next;
    }


    Node second = reverse(slow);


    Node first = head;


    while(second != null){
        if(first.data != second.data){
            return false;
        }


        first = first.next;
        second = second.next;
    }


    return true;
}

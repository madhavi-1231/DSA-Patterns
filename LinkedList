public class IntersectionOfTwoLL {
    public static void main(String[] args){
   
        Node headA = new Node(1);
        headA.next = new Node(9);
        headA.next.next = new Node(1);

        Node common = new Node(2);
        common.next = new Node(4);

        headA.next.next.next = common;

        Node headB = new Node(3);
        headB.next = common;
        intersection(headA,headB);
    }
    static void intersection(Node head1,Node head2){
        int len1=findLen(head1);
        int len2=findLen(head2);
        Node temp1=head1;
        Node temp2=head2;
        if(len1>len2){
            int diff=len1-len2;
            while(diff>0){
                temp1=temp1.next;
                diff--;
            }
        }
        else{
            int diff=len2-len1;
            while(diff>0){
                temp2=temp2.next;
                diff--;
            }
        }
        while(temp1!=null && temp2!=null){
            if(temp1==temp2){
                System.out.println(temp1.data);
                return;
            }
            temp1=temp1.next;
            temp2=temp2.next;
        }
    }
    static int findLen(Node head){
        Node temp=head;
        int len=0;
        while(temp!=null){
            len++;
            temp=temp.next;
        }
        return len;
    }
}

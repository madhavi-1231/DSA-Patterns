5. Remove Nth Node From End
Pattern
Node removeNth(Node head, int n){


    Node dummy = new Node(0);
    dummy.next = head;


    Node fast = dummy;
    Node slow = dummy;


    for(int i = 0; i <= n; i++){
        fast = fast.next;
    }


    while(fast != null){
        fast = fast.next;
        slow = slow.next;
    }


    slow.next = slow.next.next;


    return dummy.next;
}
Used In
Remove Nth Node
K Distance Problems
Two Pointer Problems
6. Palindrome Linked List
Pattern
boolean isPalindrome(Node head){


    Node slow = head;
    Node fast = head;


    while(fast != null && fast.next != null){
        slow = slow.next;
        fast = fast.next.next;
    }


    Node second = reverse(slow);


    Node first = head;


    while(second != null){
        if(first.data != second.data){
            return false;
        }


        first = first.next;
        second = second.next;
    }


    return true;
}
Used In
Palindrome Linked List
Half Reversal Problems
7. Add Two Numbers
Pattern
Node add(Node l1, Node l2){


    Node dummy = new Node(-1);
    Node temp = dummy;


    int carry = 0;


    while(l1 != null || l2 != null || carry != 0){


        int sum = carry;


        if(l1 != null){
            sum += l1.data;
            l1 = l1.next;
        }


        if(l2 != null){
            sum += l2.data;
            l2 = l2.next;
        }


        temp.next = new Node(sum % 10);
        carry = sum / 10;


        temp = temp.next;
    }


    return dummy.next;
}


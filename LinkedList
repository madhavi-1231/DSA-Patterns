2. Fast & Slow Pointer (Middle Node)
Pattern
Node middle(Node head){
    Node slow = head;
    Node fast = head;


    while(fast != null && fast.next != null){
        slow = slow.next;
        fast = fast.next.next;
    }
    return slow;
}

import java.util.*;

class Solution {
    public int longestSubarray(int[] arr, int k) {
        Map<Long, Integer> map = new HashMap<>();

        long sum = 0;
        int maxLen = 0;

        for (int i = 0; i < arr.length; i++) {
            sum += arr[i];

            if (sum == k) {
                maxLen = i + 1;
            }

            long remaining = sum - k;

            if (map.containsKey(remaining)) {
                maxLen = Math.max(
                    maxLen, i - map.get(remaining)
                );
            }

            map.putIfAbsent(sum, i);
        }

        return maxLen;
    }
}


import java.util.*;

class Solution {
    public int subarraySum(int[] arr, int k) {
        Map<Integer, Integer> map = new HashMap<>();

        map.put(0, 1);

        int sum = 0;
        int count = 0;

        for (int x : arr) {
            sum += x;

            int required = sum - k;

            count += map.getOrDefault(required, 0);

            map.put(sum, map.getOrDefault(sum, 0) + 1);
        }

        return count;
    }
}



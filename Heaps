class Solution {
    public int connectSticks(List<Integer> sticks) {
    int sum=0;
    PriorityQueue<Integer> pq=new PriorityQueue<>();
    for(int i=0;i<sticks.size();i++){
       pq.add(sticks.get(i));
    }
    int total=0;
    while(pq.size()>1){
        int a=pq.poll();
        int b=pq.poll();
        sum=a+b;
        total+=sum;
        pq.add(sum);
    }
        return total;}}



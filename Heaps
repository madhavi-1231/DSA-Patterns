class Solution {
    public int leastInterval(char[] tasks, int n) {
        int freq[]=new int[26];
        for(char ch:tasks){
            freq[ch-'A']++;
        }
        PriorityQueue<Integer> pq=new PriorityQueue<>((a,b)->b-a);
        for(int i=0;i<freq.length;i++){
              if(freq[i]>0){
                pq.add(freq[i]);
              }
        }
        int time=0;
        while(!pq.isEmpty()){
            int cycles=n+1;
            List<Integer> temp=new ArrayList<>();
            int taskCount=0;
            for(int i=0;i<cycles;i++){
                  if(!pq.isEmpty()){
                    int current=pq.poll();
                    current--;
                    if(current>0){
                        temp.add(current);
                    }
                    taskCount++;
                  }
            }
            for(int remain:temp){
                pq.add(remain);
            }
            if(!pq.isEmpty()){
                time+=cycles;
            }
            else{
                time+=taskCount;
            }
        }
        return time;
    }
}

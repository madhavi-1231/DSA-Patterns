class Solution {
    public String removeOuterParentheses(String s) {
        int counter=0;
        String str="";
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='('){
                 counter++;
                if(s.charAt(i)=='(' && counter>1){
                str=str+s.charAt(i);
            }
            }
            else{
                      counter--;
                if(s.charAt(i)==')' && counter>0){
                str=str+s.charAt(i);
            }
            }
        }
        return str;
    }
}

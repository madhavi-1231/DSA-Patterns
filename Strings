public class LongestPalindromicSubstring {
    public static void main(String[] args){
        String s="cbbd";
        String ans="";
        for(int i=0;i<s.length();i++){
            for(int j=i;j<s.length();j++){
                if(check(i,j,s)){
                   if(j-i+1>ans.length()){
                    ans=s.substring(i,j+1);}}}}
        System.out.println(ans);}
    static boolean check(int i,int j,String s){
        while(i<j){
            if(s.charAt(i)!=s.charAt(j)){
                return false;
            }
            i++;
            j--;
        }
        return true;}}
tc:O(n^2)

optimal
====================
->from current character to expand to left and right and then check valid palindromic substring or not.this process continuous for finding longest palindromic substring

public class LongestPalindromicSubstring {
    public static void main(String[] args){
        String s="cbbd";
        String ans="";
        for(int i=0;i<s.length();i++){
            String odd=check(i,i,s);
            String even=check(i,i+1,s);
            if(odd.length()>ans.length()){
                ans=odd;
            }
            if(even.length()>ans.length()){
                ans=even;
            }
        }

        System.out.println(ans);
    }
    static String check(int l,int r,String s){
        while(l>=0 && r<s.length() && s.charAt(l)==s.charAt(r)){
            l--;
            r++;
        }
        return s.substring(l+1,r);
    }
}

























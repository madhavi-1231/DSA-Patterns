import java.util.*;
public class SubArraysWithKDifferentIntegers {
    public static void main(String[] args){
        int nums[]={1,2,1,3,4};
        int k=3;
        int count=0;
        for(int i=0;i<nums.length;i++){
            HashSet<Integer> set=new HashSet<>();
            for(int j=i;j<nums.length;j++){
                                set.add(nums[j]);

                if(set.size()>k){
                    break;
                }
                if(set.size()==k){
                    count++;}}}
        System.out.println(count);
    }
}
it takes the complexity of O(n^2)
space complexity O(1)
by using 2 pointers the right stuck we cannot calculate all the valid output count so that we use hashmap+sliding window appraoch


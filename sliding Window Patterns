public class MinimumWindowSubstring {
    public static void main(String[] args){
        String s="ADOBECODEBANC";
        String t="ABC";
        int m[]=new int[256];
        int n[]=new int[256];
        for(int i=0;i<t.length();i++){
            m[t.charAt(i)]++;
    }
    int mini=Integer.MAX_VALUE;
    int j=0;
    int startIndex=0;
    for(int i=0;i<s.length();i++){
         n[s.charAt(i)]++;
          while(isValid(m,n)){
            if(i-j+1<mini){
                mini=i-j+1;
                startIndex=j;
            }
            n[s.charAt(j)]--;
            j++;
          }
    }
    System.out.println(s.substring(startIndex,startIndex+mini));
}
    static boolean isValid(int m[],int n[]){
        for(int i=0;i<m.length;i++){
            if(m[i]>n[i]){
               return false;
            }
        }
        return true;
    }

}


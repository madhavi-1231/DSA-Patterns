import java.util.*;
public class SortStack {
    public static void main(String[] args){
Stack<Integer> st=new Stack<Integer>();
st.push(4);
st.push(3);
st.push(5);
st.push(1);
sortStack(st);
System.out.println(st);
    }
    static void sortStack(Stack<Integer> st){
        if(st.isEmpty()){
            return;
        }
        int value=st.pop();
        sortStack(st);
        insertValues(st,value);
    }
    static void insertValues(Stack<Integer> st,int value){
        if(st.isEmpty() || st.peek()<=value){
            st.push(value);
            return;
        }
        int temp=st.pop();
        insertValues(st,value);
        st.push(temp);
    }
}






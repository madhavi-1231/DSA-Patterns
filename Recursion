public class CountAllSubsequences {
    public static void main(String[] args){
        int nums[]={4,2,10,5,1,3};
        int target=5;
        System.out.println(countAllSubseq(nums,0,target));
    }
    static int countAllSubseq(int nums[],int index,int target){
        if(target==0){
            return 1;
        }
        if(index==nums.length){
            return 0;
        }
                    int left= countAllSubseq(nums,index+1,target);
                    int right=0;
                    if(nums[index]<=target){
         right=0+countAllSubseq(nums,index+1,target-nums[index]);
                    }
                    return left+right;}
}

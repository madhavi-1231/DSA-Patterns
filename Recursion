 static void combination(int cand[],int index,int target,ArrayList<Integer> sub,HashSet<ArrayList<Integer>> set){
   

              if (target == 0) {
            ArrayList<Integer> temp = new ArrayList<>(sub);

            if (!set.contains(temp)) {
                set.add(temp);
                al.add(temp);
            }
            return;
        }
         if(index==cand.length){
        return;}
    
    if(cand[index]<=target){
        sub.add(cand[index]);
        combination(cand,index+1,target-cand[index],sub,set);
        sub.remove(sub.size()-1);
    }
    combination(cand,index+1,target,sub,set);
 }

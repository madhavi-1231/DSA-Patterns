public class ValidParenthesesChecker{
    public static void main(String[] args){
        String s="())";
        int cnt=0;
        System.out.println(valid(s,0,cnt));
    }
    static boolean valid(String s,int index,int cnt){
        if(cnt<0){
            return false;
        }
        if(index==s.length()){
            if(cnt==0){
                return true;
            }
            return false;
        }
        if(s.charAt(index)=='('){
              return valid(s,index+1,cnt+1);
        }
        if(s.charAt(index)==')'){
           return valid(s,index+1,cnt+1);
        }
        else{
                  return valid(s,index+1,cnt+1) || valid(s,index+1,cnt+1) || valid(s,index+1,cnt);
        }
    }
}

import java.util.*;

public class NMeetingRooms {
    public static void main(String[] args) {

        int newArr[][] = {
            {10,20}, {12,25}, {20,30}
        };

        Arrays.sort(newArr, (a,b) -> a[1] - b[1]);

        int cnt = 1;
        int last = newArr[0][1];

        for (int i = 1; i < newArr.length; i++) {

            if (last <= newArr[i][0]) {
                cnt++;
                last = newArr[i][1];
            }
        }

        System.out.println(cnt);
    }
}

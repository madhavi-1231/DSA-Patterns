public class FloorAndCeil{
    public static void main(String[] args){
        int nums[]={2, 4, 6, 8, 10, 12, 14};
        int x=1;
       int low=0;
       int floor=-1;
       int ceil=-1;
       int high=nums.length;
       while(low<=high){
        int mid=(low+high)/2;
        if(nums[mid]<=x){
            floor=nums[mid];
            low=mid+1;
        }
        else{
             high=mid-1;
        }
       }
        low=0;
        high=nums.length-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(nums[mid]<x){
                low=mid+1;
            }
            else{
                ceil=nums[mid];
                high=mid-1;
            }
        }
       System.out.println(floor+" "+ceil);
       
    }
    
    }



public class SearchEle{
    public static void main(String[] args){
        int nums[]={-1,0,3,5,9,12};
        int target=30;
        int low=0;
        int n=nums.length;
        int high=n-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(nums[mid]==target){
                System.out.println(mid);
                break;
            }
            else if(target>nums[mid]){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        System.out.println(-1);
    }
}

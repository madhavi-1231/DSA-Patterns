public class LowerBound {
    public static void main(String[] args){
        int nums[]={1,2,2,3};
        int low=0;
        int x=9;
        int answer=nums.length;
        int high=nums.length-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(nums[mid]>=x){
                answer=mid;
                high=mid-1;
            }
            else{
               low=mid+1;
            }
        }
        System.out.println(answer);    }}
